{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!styles\\.css|app\\.js|favicon\\.ico|assets|docs).*)",
      "destination": "/index.html"
    }
  ]
}
